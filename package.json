{
  "name": "china-admin-memory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "中国行政区记忆助手 - 记忆全国地级行政区（自由/自测BFS/挑战/记忆 四模式）",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:data": "node scripts/build-data.mjs",
    "dev:api": "wrangler pages dev dist",
    "db:init:local": "wrangler d1 execute china-admin-memory-db --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute china-admin-memory-db --remote --file=schema.sql",
    "deploy": "npm run build && wrangler pages deploy dist",
    "typecheck:functions": "tsc -p functions/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "echarts": "^5.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@turf/boolean-intersects": "^7.2.0",
    "@turf/simplify": "^7.2.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.0",
    "wrangler": "^4.127.1"
  }
}
