{
  "name": "map-memory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "地图记忆 - 中国行政区和世界国家记忆助手（输入/点击/无尽闯关/熟练度分析 多模式）",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:seo && tsc && vite build",
    "build:seo": "node scripts/build-subregions.mjs && node scripts/gen-seo-pages.mjs",
    "preview": "vite preview",
    "build:data": "node scripts/fetch-cn-atlas.mjs",
    "dev:api": "wrangler pages dev dist",
    "db:init:local": "wrangler d1 execute china-admin-memory-db --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute china-admin-memory-db --remote --file=schema.sql",
    "deploy": "npm run build && wrangler pages deploy dist",
    "typecheck:functions": "tsc -p functions/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@turf/boolean-intersects": "^7.2.0",
    "@turf/simplify": "^7.2.0",
    "@types/topojson-client": "^3.1.5",
    "mapshaper": "^0.7.61",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.0",
    "wrangler": "^4.127.1"
  }
}
